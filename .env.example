# scripts/setup-env.sh or setup-env.ps1 creates random values below.
DATABASE_PASSWORD=
APP_SECRET=
APP_BASE_URL=http://localhost:8080
APP_PORT=8080
BIND_ADDRESS=127.0.0.1
COOKIE_SECURE=false
DOMAIN=
# Enable only after filling credentials: google,mail
SPRING_PROFILES_ACTIVE=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

# Optional HTTPS email for Render Free; API key stays outside Git.
MAIL_ENABLED=false
MAIL_PROVIDER=smtp
BREVO_API_KEY=

# Local is the default; use cloudinary for durable food-post images on Render.
IMAGE_STORAGE_PROVIDER=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
